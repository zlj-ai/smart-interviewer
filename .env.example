# AI Provider（OpenAI 兼容接口，base-url 需含 /v1 前缀）
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CHAT_MODEL=qwen-plus
AI_DEFAULT_PROVIDER=dashscope
# 按任务路由模型（可选）：evaluation/rewrite 等轻任务可指向低成本档位 Provider
AI_ROUTE_EVALUATION=dashscope
AI_ROUTE_REWRITE=dashscope
AI_EMBEDDING_MODEL=text-embedding-v3

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smart_interviewer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT 签名密钥（HS256，至少 32 字节；建议 openssl rand -base64 48 生成）
JWT_SECRET=

# 对象存储（S3 兼容：MinIO / RustFS）
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=resumes

# 应用
SERVER_PORT=8080
